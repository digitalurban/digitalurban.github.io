<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ excerpt or site.tagline }}" />
<link rel="canonical" href="{{ site.url }}{{ page.url }}" />
<meta property="og:site_name" content="{{ site.title }}" />
<meta property="og:title" content="{{ title or site.title }}" />
<meta property="og:description" content="{{ excerpt or site.tagline }}" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@digitalurban" />
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#c8481f" />
<meta property="og:image" content="{{ site.url }}{% if hero %}{{ hero }}{% else %}/share-card.png{% endif %}" />
{% if pagination %}{% if pagination.href.previous %}<link rel="prev" href="{{ site.url }}{{ pagination.href.previous }}" />{% endif %}{% if pagination.href.next %}<link rel="next" href="{{ site.url }}{{ pagination.href.next }}" />{% endif %}{% endif %}
<link rel="stylesheet" href="/css/site.css?v={{ site.cssVersion }}" />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": {{ site.title | dump | safe }},
  "description": {{ site.tagline | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "inLanguage": "en-GB",
  "author": {
    "@type": "Person",
    "name": {{ site.author | dump | safe }},
    "jobTitle": {{ site.role | dump | safe }},
    "affiliation": { "@type": "Organization", "name": {{ site.affiliation | dump | safe }} },
    "url": "{{ site.url }}/about/",
    "sameAs": [{{ site.social.twitter | dump | safe }}, {{ site.social.github | dump | safe }}, {{ site.social.youtube | dump | safe }}, {{ site.social.profile | dump | safe }}]
  }
}
</script>
</head>
<body>

<header class="site-head">
  <div class="site-head__in">
    <a class="wordmark" href="/"><span class="wordmark__mark">DU</span>{{ site.title }}</a>
    <nav class="site-nav">
      <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Latest</a>
      <a href="/projects/"{% if '/projects/' in page.url %} aria-current="page"{% endif %}>Projects</a>
      <a href="/books/"{% if '/books/' in page.url %} aria-current="page"{% endif %}>Books</a>
      <a href="/archive/"{% if '/archive/' in page.url %} aria-current="page"{% endif %}>Archive</a>
      <a href="/about/"{% if '/about/' in page.url %} aria-current="page"{% endif %}>About / Papers</a>
    </nav>
  </div>
</header>

{{ content | safe }}

<footer class="site-foot">
  <div class="site-foot__in">
    <div class="site-foot__l">
      <span>&copy; {{ "" | year }} {{ site.author }} &middot; UCL</span>
      <span class="site-foot__c">{{ collections.posts | length }} posts since {{ (collections.posts | last).date | date("yyyy") }} &middot; <a href="/about/#papers">{{ papers.count }} publications</a> &middot; <a href="/books/">2 books</a> &middot; <a href="/books/">3 booklets</a> &middot; <a href="/about/#albums">{{ albums.length }} album{% if albums.length != 1 %}s{% endif %}</a></span>
    </div>
    <nav>
      <a href="{{ site.social.twitter }}">Twitter</a>
      <a href="{{ site.social.youtube }}">YouTube</a>
      <a href="{{ site.social.instagram }}">Instagram</a>
      <a href="{{ site.social.github }}">GitHub</a>
      <a href="/feed.xml">RSS</a>
      <a href="/archive/">Archive</a>
    </nav>
  </div>
</footer>

<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "b8d725d6a62042628cf22ac8be8652bc"}'></script>

</body>
</html>
