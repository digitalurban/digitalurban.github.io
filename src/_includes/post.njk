---
layout: base.njk
---
<article>
  <header class="wrap">
    <p style="padding-top:48px;margin:0"><a class="mono" href="/">&larr; Latest</a></p>
    <div class="post-head">
      <div class="mono post-head__meta">
        {% for c in categories %}<span class="mono--accent">{{ c }}</span>{% endfor %}
        <span>{{ page.date | date }}</span>
        <span>{{ content | readingTime }} min read</span>
      </div>
      <h1>{{ title }}</h1>
      <div class="mono post-head__by">
        <span>{{ author or site.author }}</span>
        <span>CASA, UCL East</span>
      </div>
    </div>
  </header>

  <div class="wrap">
    <div class="post-body">
      <div class="prose">
        {{ content | safe }}
      </div>
      {% if tags %}
      <footer class="post-tags">
        <span class="mono">Tagged</span>
        <div class="chips">
          {% for t in tags %}<a class="chip" href="/tag/{{ t | slugify }}/">{{ t }}</a>{% endfor %}
        </div>
      </footer>
      {% endif %}
    </div>
  </div>

  <nav class="dark">
    <div class="dark__in">
      <div class="pn">
        {% set prev = collections.posts | getPreviousCollectionItem %}
        {% set next = collections.posts | getNextCollectionItem %}
        {% if next %}
        <a href="{{ next.url }}">
          <span class="mono">&larr; Previous</span>
          <span class="pn__t">{{ next.data.title }}</span>
        </a>
        {% else %}<span></span>{% endif %}
        {% if prev %}
        <a class="pn__next" href="{{ prev.url }}">
          <span class="mono">Next &rarr;</span>
          <span class="pn__t">{{ prev.data.title }}</span>
        </a>
        {% endif %}
      </div>
    </div>
  </nav>

  <section class="wrap">
    <div class="comments">
      <div>
        <div class="mono" style="padding-bottom:12px">Recent</div>
        <div class="rows">
          {% for p in collections.posts | head(5) %}
          <a href="{{ p.url }}">{{ p.data.title }}</a>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
</article>
